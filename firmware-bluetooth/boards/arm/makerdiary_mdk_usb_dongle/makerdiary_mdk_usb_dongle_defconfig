CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_MAKERDIARY_MDK_USB_DONGLE=y

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# The user button sits on P0.18 (the nRF52840 reset pin).
# Keep it a normal GPIO so hid-remapper can use it for pairing/forget.
CONFIG_GPIO_AS_PINRESET=n

# Use the internal RC oscillator for the 32 kHz clock so the firmware
# does not depend on an external 32.768 kHz crystal.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_PINCTRL=y
